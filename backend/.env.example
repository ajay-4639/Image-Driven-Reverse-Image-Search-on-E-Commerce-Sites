# Application settings
APP_NAME=Image Search API
APP_VERSION=1.0.0
DEBUG=false

# Server settings
HOST=0.0.0.0
PORT=8000

# CORS settings (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Data paths
DATA_DIR=./data/fashion-images
UPLOAD_DIR=./uploads
IMAGEBIND_PATH=./ImageBind

# Model settings
DEVICE=cuda
EMBEDDING_DIM=1024

# Qdrant settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=imagebind_data
USE_IN_MEMORY=true
